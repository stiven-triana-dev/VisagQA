                  "    pm.response.to.have.status(200);",
                  "    const empezados = pm.response.json().filter((p) => p.estado !== 'PLANIFICADO');",
                  "    pm.expect(empezados).to.not.be.empty;",
                  "    const ultimo = empezados.sort((a, b) => a.fechaInicio.localeCompare(b.fechaInicio)).pop();",
