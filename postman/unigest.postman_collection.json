{
  "info": {
    "_postman_id": "a8cc8c39-016d-4463-adab-e13aa3d352e8",
    "name": "UniGest API",
    "description": "Pruebas de la API de UniGest en su demo pública. Solo lectura: inicia sesión con las cuentas de demostración, consulta y cierra sesión; no crea ni cambia datos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Estado y demo",
      "description": "Rutas públicas: salud del servicio, versión y cuentas de la demo.",
      "item": [
        {
          "name": "Estado del servicio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{unigest}}/api/v1/estado",
              "host": [
                "{{unigest}}"
              ],
              "path": [
                "api",
                "v1",
                "estado"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 en menos de 5 segundos', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('dice que UniGest está bien', () => {",
                  "    const datos = pm.response.json();",
                  "    pm.expect(datos.estado).to.eql('OK');",
                  "    pm.expect(datos.aplicacion).to.eql('UniGest');",
                  "    pm.expect(datos.version).to.match(/^\\d+\\.\\d+\\.\\d+$/);",
                  "    pm.collectionVariables.set('version_estado', datos.version);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Documentación OpenAPI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{unigest}}/v3/api-docs",
              "host": [
                "{{unigest}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 con la especificación', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().info.title).to.eql('UniGest API');",
                  "});",
                  "pm.test('la versión del estado coincide con la de la documentación', () => {",
                  "    pm.expect(pm.collectionVariables.get('version_estado')).to.eql(pm.response.json().info.version);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cuentas de la demo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{unigest}}/api/v1/demo",
              "host": [
                "{{unigest}}"
              ],
              "path": [
                "api",
                "v1",
                "demo"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('la demo está activa con sus tres cuentas', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const datos = pm.response.json();",
                  "    pm.expect(datos.activo).to.eql(true);",
                  "    pm.expect(datos.cuentas.map((c) => c.correo)).to.eql(['admin@demo.test', 'docente@demo.test', 'estudiante@demo.test']);",
                  "    pm.expect(datos.clave).to.eql(pm.environment.get('unigest_clave'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
