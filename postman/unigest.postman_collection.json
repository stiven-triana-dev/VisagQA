                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test('responde 200 con una página de estudiantes', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(datos.content).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(datos.totalElements).to.be.at.least(datos.content.length);",
                  "});",
                  "pm.test('cada estudiante trae sus campos', () => {",
                  "    datos.content.forEach((e) => {",
                  "        pm.expect(e).to.include.keys('id', 'codigo', 'documento', 'nombres', 'apellidos', 'correo', 'programa');",
                  "        pm.expect(e.codigo).to.match(/^\\d{5}-\\d{4}$/);",
                  "    });",
                  "});",
                  "pm.test('guarda un estudiante distinto al de la demo para la prueba de acceso indebido', () => {",
                  "    const otro = datos.content.find((e) => e.correo !== 'estudiante@demo.test');",
                  "    pm.expect(otro).to.exist;",
                  "    pm.collectionVariables.set('otro_estudiante_id', otro.id);",
                  "});"
                ]
              }
            }
          ]
