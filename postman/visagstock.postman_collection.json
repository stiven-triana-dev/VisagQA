{
  "info": {
    "_postman_id": "eeab27bb-cc3f-4d48-bb04-5f65b4d3dd8d",
    "name": "VisagStock API",
    "description": "Pruebas de la API del inventario. La carpeta \"Invitado en línea\" usa la aplicación publicada sin guardar nada; la carpeta \"Administrador local\" usa una copia local y sí registra movimientos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Invitado en línea",
      "description": "VisagStock publicado, con la cuenta de invitado: el servidor valida y calcula, pero nunca guarda. Usa la variable {{visagstock}}.",
      "item": [
        {
          "name": "Estado del servicio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{visagstock}}/api/estado",
              "host": [
                "{{visagstock}}"
              ],
              "path": [
                "api",
                "estado"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 con estado ok', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.eql({ estado: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
