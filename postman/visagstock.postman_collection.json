                  "pm.test('el último movimiento del jean es el que acabamos de registrar', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const ultimo = pm.response.json().movimientos[0];",
                  "    pm.expect(String(ultimo.id)).to.eql(String(pm.collectionVariables.get('movimiento_id')));",
                  "    pm.expect(ultimo.tipo).to.eql('ingreso');",
                  "    pm.expect(ultimo.motivo).to.eql('Compra a proveedor (Postman)');",
                  "});"
                ]
              }
            }
