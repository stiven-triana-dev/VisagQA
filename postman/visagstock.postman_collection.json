        {
          "name": "Ingreso de prueba (simulado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{visagstock}}/api/movimientos",
              "host": [
                "{{visagstock}}"
              ],
              "path": [
                "api",
                "movimientos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": \"p042\",\n  \"tallaId\": \"{{invitado_talla_id}}\",\n  \"tipo\": \"ingreso\",\n  \"condicion\": null,\n  \"cantidad\": 3,\n  \"motivo\": \"Prueba de Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = JSON.parse(pm.request.body.raw.replace('\"{{invitado_talla_id}}\"', pm.collectionVariables.get('invitado_talla_id')));",
                  "pm.request.body.raw = JSON.stringify(cuerpo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test('responde 200 marcado como simulado', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(datos.simulado).to.eql(true);",
                  "    pm.expect(datos.usuario).to.eql('invitado');",
                  "});",
                  "pm.test('calcula el stock que quedaría', () => {",
                  "    pm.expect(datos.stockResultante).to.eql(Number(pm.collectionVariables.get('invitado_stock')) + 3);",
                  "});"
                ]
              }
            }
          ]
        },
