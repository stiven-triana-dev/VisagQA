        {
          "name": "Entrar como invitado",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{visagstock}}/api/sesion/invitado",
              "host": [
                "{{visagstock}}"
              ],
              "path": [
                "api",
                "sesion",
                "invitado"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('entra como invitado', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.eql({ usuario: 'invitado', invitado: true });",
                  "});",
                  "pm.test('la cookie de sesión es HttpOnly y SameSite=Strict', () => {",
                  "    const cookie = pm.response.headers.get('Set-Cookie') || '';",
                  "    pm.expect(cookie).to.include('visagstock_sesion=');",
                  "    pm.expect(cookie).to.include('HttpOnly');",
                  "    pm.expect(cookie).to.include('SameSite=Strict');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resumen del inventario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{visagstock}}/api/resumen",
              "host": [
                "{{visagstock}}"
              ],
              "path": [
                "api",
                "resumen"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test('responde 200 con los 108 productos de la tienda', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(datos.productos).to.eql(108);",
                  "});",
                  "pm.test('las cifras son coherentes', () => {",
                  "    pm.expect(datos.unidades).to.be.at.least(0);",
                  "    pm.expect(datos.agotados + datos.bajos).to.be.at.most(datos.productos);",
                  "    pm.expect(datos.ultimos7Dias).to.include.keys('movimientos', 'ingresos', 'despachos', 'devoluciones', 'danadas');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar productos sin importar mayúsculas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{visagstock}}/api/productos?buscar=JEAN BAGGY&porPagina=5",
              "host": [
                "{{visagstock}}"
              ],
              "path": [
                "api",
                "productos"
              ],
              "query": [
                {
                  "key": "buscar",
                  "value": "JEAN BAGGY"
                },
                {
                  "key": "porPagina",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test('responde 200 y respeta el tamaño de página', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(datos.total).to.be.above(0);",
                  "    pm.expect(datos.productos.length).to.be.at.most(5);",
                  "});",
                  "pm.test('todos los resultados son jeans baggy', () => {",
                  "    datos.productos.forEach((p) => pm.expect(p.nombre.toLowerCase()).to.include('jean baggy'));",
                  "});"
                ]
              }
            }
          ]
