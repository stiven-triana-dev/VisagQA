              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": \"p042\",\n  \"tallaId\": \"{{admin_talla_id}}\",\n  \"tipo\": \"despacho\",\n  \"condicion\": null,\n  \"cantidad\": 100000,\n  \"motivo\": \"Venta en tienda\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = JSON.parse(pm.request.body.raw.replace('\"{{admin_talla_id}}\"', pm.collectionVariables.get('admin_talla_id')));",
                  "pm.request.body.raw = JSON.stringify(cuerpo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 409 y no resta nada', () => {",
