              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test('responde 200 con el jean y sus 5 tallas', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(datos.producto.id).to.eql('p042');",
                  "    pm.expect(datos.producto.tallas.map((t) => t.talla)).to.eql(['24-4', '26-6', '28-8', '30-10', '32-12']);",
                  "});",
                  "const talla = datos.producto.tallas.find((t) => t.talla === '28-8');",
                  "pm.collectionVariables.set('invitado_talla_id', talla.tallaId);",
                  "pm.collectionVariables.set('invitado_stock', talla.cantidad);",
                  "pm.collectionVariables.set('invitado_despacho_imposible', talla.cantidad + 1);"
                ]
              }
            }
