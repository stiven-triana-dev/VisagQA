            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"\",\n  \"pais\": \"Colombia\",\n  \"nombre\": \"Laura\",\n  \"apellidos\": \"Pruebas Postman\",\n  \"documento\": \"\",\n  \"celular\": \"3001234567\",\n  \"direccion\": \"Calle 12 # 12-57\",\n  \"complemento\": \"\",\n  \"ciudad\": \"Lebrija\",\n  \"departamento\": \"Santander\",\n  \"postal\": \"\",\n  \"medio-pago\": \"contraentrega\",\n  \"facturacion\": \"misma\",\n  \"fact_direccion\": \"\",\n  \"fact_ciudad\": \"\",\n  \"fact_departamento\": \"\",\n  \"items\": [\n    {\n      \"id\": \"p042\",\n      \"talla\": \"28-8\",\n      \"cant\": 1,\n      \"precio\": 1,\n      \"price\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.test('responde 201 con un número de pedido VS', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(datos.code).to.match(/^VS-\\d{4,}$/);",
                  "    pm.collectionVariables.set('pedido_codigo', datos.code);",
                  "    pm.collectionVariables.set('pedido_numero', datos.number);",
                  "});",
                  "pm.test('ignora el precio enviado y cobra el real: 130.000', () => pm.expect(datos.subtotal).to.eql(130000));"
                ]
              }
            }
          ]
        },
